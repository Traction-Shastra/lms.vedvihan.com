# Copy to .env on the server and fill in. Never commit .env.

DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
# MariaDB root/privileged login, only used by `bench new-site` to create the
# database. Reachable only from the backend_shared network.
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
